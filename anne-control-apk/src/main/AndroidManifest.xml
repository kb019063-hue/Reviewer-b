<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.annecontrol.p20lite"
    android:versionCode="105"
    android:versionName="1.0.5">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="28" />

    <!-- Elevated & System-Level Permissions (Zero Internet Permission = 100% Offline & Private!) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
        Removed in 1.0.2: WRITE_SECURE_SETTINGS and GET_PACKAGE_SIZE. Neither was
        granted from the manifest nor used anywhere in the code, and the Power tab
        told users to `pm grant` WRITE_SECURE_SETTINGS for a feature that does not
        exist. Re-add both only together with the code that actually needs them.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AnneAccessibilityService"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Backs the STOP action on the ongoing notification shown during a run. -->
        <receiver
            android:name=".StopAutomationReceiver"
            android:exported="false" />

    </application>
</manifest>
